# Copy this file to .env and fill in the values. .env stays on this machine.

# Project URL. Server-side Data API calls use this.
SUPABASE_URL=

# Server-only secret key (sb_secret_...). Full access to project data.
# Never use a NEXT_PUBLIC_ name for this, and never put it in client code.
SUPABASE_SECRET_KEY=

# Direct Postgres URL for SQL migrations and pg_dump. Port 5432 on db.<project-ref>.supabase.co.
# The running app does not use this to read or write rows.
# If the direct host is unreachable, use the session-mode pooler URL (port 5432) here instead.
DIRECT_URL=

# Owner account created by npm run db:seed. Used only when no user exists.
SEED_USER_EMAIL=
SEED_USER_PASSWORD=

# Trusted single-user mode. Defaults to SEED_USER_EMAIL when omitted.
# Do not expose this app directly to the public internet in this mode.
LIFE_TRACKER_OWNER_EMAIL=
